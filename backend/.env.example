PORT=4000

# --- PostgreSQL (pick ONE approach) ---
# Cloud (Render, Neon, Railway, Supabase): use full DATABASE_URL + SSL
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
#   DATABASE_SSL=true
# Local / Docker: leave DATABASE_URL empty and use DATABASE_* below
DATABASE_URL=
DATABASE_SSL=false
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=martin_enterprise
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000

# Backups (schedule npm run db:backup; copy offsite — see docs/DEPLOYMENT-OFFSITE-BACKUP.md)
BACKUP_DIR=

# Production logging: JSON lines to stderr; set LOG_FILE for rotation via logrotate
LOG_FILE=

# --- Redis (optional — speeds up auth/session cache; app works without it) ---
# Easiest: paste your provider URL (Upstash, Render, Redis Cloud, local Docker):
#   REDIS_URL=redis://localhost:6379
#   REDIS_URL=rediss://default:PASSWORD@HOST:6379   (TLS — Upstash / many clouds)
# Or host/port (set REDIS_ENABLED=true):
#   REDIS_ENABLED=true
#   REDIS_HOST=localhost
#   REDIS_PORT=6379
#   REDIS_PASSWORD=
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Development only — MUST be false in production (real ERP uses live API + real passwords)
ENABLE_DEMO_MODE=true
NODE_ENV=development
# Local dev: never use production here — causes HTTPS redirect on :4000 and login fails (ERR_CONNECTION_REFUSED)
STRICT_PRODUCTION_CONFIG=false
DISABLE_HTTPS_REDIRECT=true

# Legacy /api/* routes — disabled in production; set true in dev to match prod
DISABLE_LEGACY_API=true
ENABLE_LEGACY_API=false

# JWT (Module 1 auth) — use 32+ random chars in production
JWT_SECRET=your_jwt_secret_here_min_32_chars_minimum_length
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_REFRESH_REMEMBER_DAYS=30
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
PASSWORD_RESET_HOURS=24

# Admin bootstrap — set password for live login (hashed on db:migrate / go-live:password)
ADMIN_EMAIL=admin@martin.co.ke
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=MartinERP2026!

# MFA secret encryption (32-byte key recommended)
MFA_ENCRYPTION_KEY=

# Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Local dev (dev:all sets 5000 automatically); set RATE_LIMIT_DISABLED=true to turn off API throttling
RATE_LIMIT_DISABLED=false
AUTH_RATE_LIMIT_MAX=20
MAX_FAILED_LOGINS=5
PII_ENCRYPTION_KEY=change_me_32_char_minimum_secret_key
# After setting key in production: node scripts/encrypt-existing-salaries.cjs

# Upload security
MAX_POD_PHOTO_BYTES=2097152
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Database — bind Postgres to localhost/private VPC only (never 0.0.0.0 on the public internet)
DATABASE_HOST=localhost
PO_MD_APPROVAL_THRESHOLD=100000
INTERNAL_API_KEY=change_me_internal_ops_key
MPESA_CALLBACK_SECRET=change_me_mpesa_callback_secret

# App URLs
APP_BASE_URL=http://localhost:3000
# Public API URL embedded in PDF QR codes (defaults to http://localhost:4000)
API_PUBLIC_URL=http://localhost:4000

# SSO (stubs)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
SAML_ENTRY_POINT=
SAML_CERT=

# Integrations (required for live Kenya go-live — UI hides buttons until configured)
ETIMS_ENABLED=false
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SENDGRID_API_KEY=
AFRICASTALKING_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
