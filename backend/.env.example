PORT=4000
DATABASE_URL=
DATABASE_SSL=false
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_DB=

# Redis (sessions & permission cache; optional in local dev)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

NODE_ENV=development
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# JWT (Module 1 auth)
JWT_SECRET=
DOC_VERIFY_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_EXPIRES_IN=8h

# Admin bootstrap
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=
# Set true only when intentionally rotating an existing administrator password.
RESET_ADMIN_PASSWORD=false

# MFA key must be separate from JWT_SECRET and contain at least 32 characters.
MFA_ENCRYPTION_KEY=
# Provider credentials use a distinct encryption key; rotate with the admin command.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=1
INTEGRATION_ENCRYPTION_KEY_NEXT=
INTEGRATION_ENCRYPTION_KEY_NEXT_VERSION=
# Separate key used to encrypt employee national/tax/statutory identifiers and bank account numbers.
PII_ENCRYPTION_KEY=

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
MAX_FAILED_LOGINS=5
ALLOW_DB_RESET=false

# SSO (Module 1 stubs — wire providers in Module 8)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
SAML_ENTRY_POINT=
SAML_CERT=

# Integrations are configured per company through the integration settings API.
APP_BASE_URL=http://localhost:4000
ETIMS_ADAPTER_MODULE=
MPESA_ADAPTER_MODULE=
NOTIFICATION_ADAPTER_MODULE=
ETIMS_POLL_INTERVAL_MS=5000
ETIMS_BATCH_SIZE=20
MPESA_POLL_INTERVAL_MS=5000
MPESA_BATCH_SIZE=20
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_BATCH_SIZE=20
MPESA_CALLBACK_RATE_LIMIT_WINDOW_MS=60000
MPESA_CALLBACK_RATE_LIMIT_MAX=600
REPORT_SCHEDULE_POLL_INTERVAL_MS=30000
REPORT_SCHEDULE_BATCH_SIZE=10
REPORT_SCHEDULE_TIMEZONE=Africa/Nairobi
REPORT_EXPORT_RETENTION_DAYS=90
REPORT_EXPORT_DIR=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AI analysis: choose local (rules only), openai, or gemini. Model analysis sends
# permission-filtered, aggregated ERP totals and the user's question to the selected
# provider. It does not send record-level ERP rows or execute ERP transactions.
INTELLIGENCE_ENABLED=true
INTELLIGENCE_PROVIDER=local
AI_RECOMMENDATIONS_ENABLED=true
AI_AUTOMATION_ENABLED=false
AI_REQUEST_TIMEOUT_MS=10000
AI_RETENTION_DAYS=90
