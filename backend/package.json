{
  "name": "ayawin-enterprise-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "build": "node -e \"console.log('No backend build step required')\"",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:migrate": "node scripts/migrate-db.cjs",
    "db:maintain": "node scripts/maintain-db.cjs",
    "db:legacy-audit": "node scripts/audit-legacy-data.cjs",
    "db:import-certified-products": "node scripts/import-certified-products.cjs",
    "db:seed:demo": "node scripts/seed-demo.cjs",
    "db:reset": "node scripts/reset-db.cjs",
    "db:backup": "node scripts/backup-db.cjs",
    "db:restore": "node scripts/restore-db.cjs",
    "integration:keys:rotate": "node scripts/rotate-integration-encryption-key.cjs",
    "worker:etims": "node scripts/etims-outbox-worker.cjs",
    "worker:mpesa": "node scripts/mpesa-outbox-worker.cjs",
    "worker:notifications": "node scripts/notification-outbox-worker.cjs",
    "worker:reports": "node scripts/report-scheduler-worker.cjs",
    "reports:retention": "node -e \"require('./src/services/scheduledReportService').expireOldReportRuns().then(n=>console.log(n)).finally(()=>require('./src/db').end())\"",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "test:e2e:critical": "node --test --test-concurrency=1 test/e2e/sales-flow.test.js test/e2e/purchase-flow.test.js",
    "test:all": "npm test && npm run test:e2e",
    "ci:phase10": "node scripts/phase10-ci.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.4",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "ipaddr.js": "^1.9.1",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "minimatch": "^11.0.1",
    "qs": "^6.17.1"
  }
}
