VITE_API_BASE=http://localhost:4000
# Set to the API origin reachable from the user's browser in each deployment.

# API and local bootstrap. Replace security placeholders with independent random values.
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-for-local-development
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
MFA_ENCRYPTION_KEY=replace-with-independent-random-secret-at-least-32-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-independent-random-secret-at-least-32-characters
INTEGRATION_ENCRYPTION_KEY_VERSION=1
PII_ENCRYPTION_KEY=replace-with-independent-random-secret-at-least-32-characters
DOC_VERIFY_SECRET=replace-with-independent-random-secret-at-least-32-characters
REDIS_URL=redis://localhost:6379

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=ayawin_enterprise
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000

# Local backups
BACKUP_DIR=./backend/backups

# Notification worker rate limits and polling
NOTIFICATION_EMAIL_RECIPIENT_LIMIT_PER_HOUR=30
NOTIFICATION_SMS_RECIPIENT_LIMIT_PER_HOUR=5
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_POLL_INTERVAL_MS=5000

# M-Pesa callback authentication token. Use a random secret outside development.
MPESA_CALLBACK_TOKEN=replace-with-random-callback-token
